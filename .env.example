# Copy this file to ".env" and change the values. The server reads it when it starts.

ADMIN_TOKEN=choose-a-long-random-password
PORT=3000

# Signs the "you are signed in" cookie. Change this to a long random string before sharing
# the server with anyone; if you leave the default, anyone who reads the source could forge
# a session. Changing it later signs everyone out (harmless, they just sign in again).
SESSION_SECRET=choose-a-long-random-string

# Set to false to start with an empty database instead of demo data:
# SEED_DEMO=false

# ---- Optional: "Continue with Google" in the sign-in box ----
# Leave this blank and the Google button just says it isn't available yet; email still works.
# See README.md "Google sign-in" for how to get this value.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
